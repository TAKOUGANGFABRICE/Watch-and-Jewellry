# FARÉL Backend Environment Configuration
DJANGO_ENV=local
SECRET_KEY=farel-insecure-development-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in Docker/Production, SQLite default in local if unset)
# DATABASE_URL=postgres://farel_user:farel_pass@localhost:5432/farel_db
DB_NAME=watch
DB_USER=postgres
DB_PASSWORD=Fab123?
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cameroon Payment Gateways (Notch Pay / MTN MoMo / Orange Money)
NOTCH_PAY_PUBLIC_KEY=pk_test_sample
NOTCH_PAY_SECRET_KEY=sk_test_sample
NOTCH_PAY_HASH_KEY=sample_hash_key
MTN_MOMO_SUBSCRIPTION_KEY=sample_subscription_key
ORANGE_MONEY_CLIENT_ID=sample_client_id
ORANGE_MONEY_CLIENT_SECRET=sample_client_secret

# Media Storage (Cloudinary / S3)
USE_CLOUDINARY=False
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

